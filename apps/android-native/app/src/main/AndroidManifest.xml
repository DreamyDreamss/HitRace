<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeps GPS flowing while the app is backgrounded / the screen is off. Started from a
         visible screen, so ACCESS_BACKGROUND_LOCATION is deliberately NOT requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The demo/simulation run needs a foreground service but reads no sensors, so it runs as
         dataSync - claiming `location` without the runtime permission is a SecurityException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Doze can suspend the process between location callbacks even inside a foreground
         service; a partial wake lock is what keeps an hour-long run recording with the screen
         off. Held only while a run is active. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Step detector (real cadence → the sword's durability). Optional: refusing it costs the
         cadence reading, nothing else. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".HitRaceApp"
        android:allowBackup="true"
        android:label="HitRace"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HitRace">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HitRace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />
    </application>
</manifest>
